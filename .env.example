# --- Database --------------------------------------------------------------
# Skeleton default: SQLite, no server to run. Lands at prisma/dev.db
# (gitignored). To switch to Postgres later, change the `provider` in
# prisma/schema.prisma to "postgresql" and use a connection string like:
#   DATABASE_URL="postgresql://flow_bof:flow_bof@localhost:5432/flow_bof_saas?schema=public"
DATABASE_URL="file:./dev.db"

# --- Local agent integration ----------------------------------------------
# The Flow BOF Local Agent (in the sibling flow-bof-automation repo) listens
# on this URL by default. Override only if you moved the agent.
# Server-side reads NEXT_PUBLIC_AGENT_BASE_URL OR AGENT_BASE_URL.
NEXT_PUBLIC_AGENT_BASE_URL="http://127.0.0.1:9444"

# Optional bearer token. Set this when the agent itself was started with
# AGENT_API_TOKEN set. Empty = no auth.
AGENT_API_TOKEN=""

# --- Auth -----------------------------------------------------------------
# Sign-in session cookies are HS256 JWTs signed with AUTH_SECRET.
# Must be at least 32 characters. Generate with:
#   openssl rand -base64 48
AUTH_SECRET=""

# Dev-only escape hatch. When "true" AND NODE_ENV != "production", the
# app falls back to the env-driven default user/workspace below so the
# seed script + a "no signup needed" local mode keep working. NEVER
# enable in production.
ALLOW_AUTH_BYPASS="false"
DEFAULT_WORKSPACE_NAME="My Workspace"
DEFAULT_USER_EMAIL="alpha@example.com"
DEFAULT_USER_NAME="Alpha User"

# --- Runner download links (NEXT_PUBLIC_*) --------------------------------
# Filled in on production deploys; usually blank in dev. The SaaS
# Runner Setup page reads these at build time and points the
# Download buttons at real GitHub Release assets when set.
#
# Recommended: GitHub's /releases/latest/download/<filename> URL.
# Stable redirect that always serves the latest release's asset.
# Examples (uncomment + adjust):
#   NEXT_PUBLIC_RUNNER_WINDOWS_RELEASE_URL=https://github.com/jediabe/flow-bof-automation/releases/latest/download/FlowBOFRunner.exe
#   NEXT_PUBLIC_RUNNER_MAC_RELEASE_URL=https://github.com/jediabe/flow-bof-automation/releases/latest/download/FlowBOFRunner-mac-alpha.dmg
#   NEXT_PUBLIC_RUNNER_RELEASES_URL=https://github.com/jediabe/flow-bof-automation/releases
NEXT_PUBLIC_RUNNER_WINDOWS_RELEASE_URL=""
NEXT_PUBLIC_RUNNER_MAC_RELEASE_URL=""
NEXT_PUBLIC_RUNNER_RELEASES_URL=""

# --- BOF Dashboard (multi-account TikTok Shop analytics) ------------------
# Backend-only API key for TikHub (api.tikhub.io). One key serves all
# connected accounts in this workspace. Sign up at https://tikhub.io
# and copy your key here.
TIKHUB_API_KEY=""

# AES-256-GCM key used to encrypt TikTokAccount.cookieRaw at rest.
# Must decode to exactly 32 bytes. Generate with:
#   openssl rand -base64 32
# Rotating this key will invalidate every stored cookie — operators
# will have to re-paste cookies for each account.
TIKTOK_COOKIE_ENC_KEY=""

# Bearer token the cron infrastructure presents to POST
# /api/cron/health-and-revenue and POST /api/cron/products.
# Generate with:
#   openssl rand -hex 32
# Wire this into your external scheduler (Docker host crontab,
# Vercel Cron, Render Cron, etc.). See docs/CRON.md.
CRON_SECRET=""
