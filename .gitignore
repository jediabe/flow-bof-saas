prisma/dev.db-journal
prisma/migrations/migration_lock.toml.bak
*.db
*.db-journal

# Editor noise
.vscode/
.idea/

# Build artifacts
dist/
coverage/

# Locally-served reference images downloaded during Kalodata import.
# Dev-only; real production uses object storage (R2/S3) with signed
# URLs. Large enough that we never want this folder in the repo.
public/uploads/
uploads/

# Production backup tarballs from scripts/backup-prod.sh.
backups/

tsconfig.tsbuildinfo
