# Files the production build doesn't need.
# Keep this short — anything ignored here is *unavailable* during
# `docker build`, including to the deps + builder stages.

node_modules
.next
out
dist
coverage
.DS_Store
*.log
.git
.gitignore

# Local SQLite state never goes into the image.
prisma/dev.db
prisma/dev.db-journal
prisma/migrations/migration_lock.toml.bak

# Local secrets / dev env files — production reads .env.production
# from the docker-compose env_file, not from the build context.
.env
.env.local
.env.*.local
.env.production
.env.production.local

# Local-only Kalodata downloads. The production volume mount handles
# this folder at runtime.
public/uploads

# IDE noise.
.vscode
.idea
