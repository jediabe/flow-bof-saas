// Production (Postgres) variant of prisma/schema.prisma.
//
// The repo's working schema is the SQLite one — that's what
// `npm run dev` and `prisma db push` use locally. The Dockerfile
// copies this file over schema.prisma before `prisma generate` so
// the production image is built against Postgres without touching
// the dev experience.
//
// Keep this file structurally identical to schema.prisma — only the
// `datasource` block differs.
//
// SaaS skeleton schema for Flow BOF Automation.
//
// Each model maps 1:1 to a concept from docs/ARCHITECTURE.md:
//   * User / Workspace               — accounts + tenancy.
//   * Agent                          — a registered local agent instance.
//   * Batch / Product                — the user's content.
//   * Job / JobEvent                 — work queued for an agent.
//
// The skeleton does NOT model billing, auth providers, or any
// browser-cookie / credential storage — that boundary is enforced in
// docs/SECURITY.md.

generator client {
  provider = "prisma-client-js"
}

// Skeleton dev uses SQLite — no service to run. To move to Postgres
// later, change `provider` to "postgresql" and point DATABASE_URL at
// a Postgres connection string. The `@db.Text` annotations in this
// file are removed for SQLite compatibility; restore them on
// `imagePrompt` (Product) and `message` (JobEvent) if you migrate.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  // bcrypt hash. Nullable so existing dev seed rows (created before
  // signup landed) still load; new rows always populate it via the
  // signup flow.
  passwordHash String?
  // One of: "admin" | "client". Default admin; multi-tenant
  // migration can flip later. See SQLite schema for full rationale.
  role         String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaces Workspace[] @relation("WorkspaceOwner")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agents     Agent[]
  batches    Batch[]
  jobs       Job[]
  settings   WorkspaceSettings?
  // Phase 6 — Flow reconciliation. See FlowItem model below.
  flowItems  FlowItem[]
  // BOF Dashboard — TikTok Shop accounts connected to this workspace.
  tikTokAccounts TikTokAccount[]
  // Product Research — marketplace-discovered products the
  // operator is scouting/tracking. See ShopProduct at the
  // bottom of this file.
  shopProducts   ShopProduct[]
  // Workspace-scoped API token for programmatic access. See
  // SQLite schema for full rationale.
  apiToken       String? @unique
}

// ---------------------------------------------------------------------------
// Workspace-level settings — AI provider config, etc.
//
// ALPHA: API keys are stored *unencrypted* in this row. Acceptable for a
// localhost SQLite prototype; production must encrypt at rest (column-
// level KMS) or move them to a secrets manager. See docs/AI_PROVIDERS.md.
//
// Keys are never returned to client components in full; the settings
// server action returns a masked preview ("****abcd") plus a `set`
// boolean per key. Server-side workers read the row directly.
// ---------------------------------------------------------------------------

model WorkspaceSettings {
  id          String   @id @default(cuid())
  workspaceId String   @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // One of: "manual" | "openai" | "anthropic" | "openrouter".
  aiProvider  String   @default("manual")

  openaiApiKey        String?
  openaiModel         String?

  anthropicApiKey     String?
  anthropicModel      String?

  openrouterApiKey    String?
  openrouterModel     String?
  openrouterSiteUrl   String?
  openrouterAppName   String?

  // Phase 9 IP risk screening — default off after user feedback
  // that the heuristic was too aggressive. When false, existing
  // ipRiskStatus values on Product rows stay for reference but
  // stop gating Ready / image gen.
  ipRiskChecksEnabled Boolean @default(false)

  // Per-workspace overrides for the AI image-prompt system
  // prompts. When NULL, the bundled constant is used; when set,
  // the override text is fed to the AI provider verbatim. Lets
  // the user iterate on prompt wording without redeploying.
  ukSystemPromptOverride String?
  usSystemPromptOverride String?

  // v0.6.15-alpha anti-block hardening (see SQLite schema for the
  // full rationale).
  dailyImageSubmitCap Int @default(50)
  lastUnusualActivityAt   DateTime?
  lastUnusualActivityReason String?
  cooldownHours Int @default(4)

  // Cap on how many ShopProduct rows in this workspace can carry
  // isTracking=true concurrently. Guards per-workspace TikHub bill
  // against runaway Track clicks. See SQLite schema for full
  // rationale.
  shopResearchMaxTracked Int @default(25)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Agents — one row per registered local agent install.
// ---------------------------------------------------------------------------

// `status` is one of: "offline" | "online" | "unknown".
// (SQLite doesn't support Prisma enums — stored as a String. The
// TypeScript layer in src/lib/agent-client.ts + the page renderers
// know the valid set.)
model Agent {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  status      String   @default("unknown")
  baseUrl     String
  lastSeenAt  DateTime?

  // Connected-runner / polling-mode fields. The runner authenticates
  // by POSTing `Authorization: Bearer <runner_token>` to /api/runner/*;
  // only the SHA-256 hex digest of that token is stored here, so a
  // dump of the row never leaks usable credentials. `runnerTokenLast4`
  // is the human-readable preview the dashboard shows once the
  // one-time-display window has closed.
  runnerTokenHash  String?   @unique
  runnerTokenLast4 String?
  // Set the first time we see a successful /api/runner/health call
  // after generation. Cleared when the user revokes + regenerates.
  connectedAt      DateTime?
  // Bumped on every authenticated runner request — health, next-job,
  // event, complete, fail. Used to detect "runner is online right now".
  lastPollAt       DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobs Job[]

  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Content
// ---------------------------------------------------------------------------

model Batch {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  status      String    @default("draft")
  // Which TikTok Shop market this batch targets. Drives the prompt
  // template (UK retail vs US retail), hook/caption/hashtag style,
  // and posting-assist copy. Existing rows backfill to "uk".
  market      String    @default("uk")
  // Optional preset name. Per-batch tweaks like "uk-fashion-boutique"
  // without inventing a new model.
  promptPreset String?
  // Long random URL-safe token for the phone product-review page
  // (Phase 4 mobile QR). Anyone-with-URL auth.
  reviewToken  String? @unique
  postingToken String? @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products  Product[]
  jobs      Job[]
  // Phase 6 — Flow items scoped to this batch.
  flowItems FlowItem[]

  @@index([workspaceId])
}

model Product {
  id                 String   @id @default(cuid())
  batchId            String
  batch              Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  productName        String
  originalTitle      String?
  tiktokUrl          String?
  category           String?
  retailerName       String?
  imageUrl           String?
  // Cloud-hosted reference image URL. Reserved for future signed-URL
  // download support; the local runner can't fetch these yet.
  referenceImageUrl  String?
  // Local filesystem path the runner uses to read the reference image
  // (e.g. "inputs/reference_images/01_primary.jpg"). Must resolve on
  // the runner machine. Phase-3-cloud will replace this with signed
  // URL downloads on the runner side.
  referenceImagePathLocal String?
  imagePrompt        String?
  // AI-generated supporting copy. Optional — populated by
  // generateAiPrompts; manual / deterministic fallback leaves them null.
  hook               String?
  // JSON-encoded array of all hook variants the AI generated.
  // Shape: [{label, text, lever_name?}]. The `hook` field above
  // is hookVariants[0].text — denormalised cache so mobile-posting
  // / cooldown-banner consumers reading a single hook keep working.
  hookVariants       String?
  caption            String?
  // JSON-encoded string[] (SQLite has no array type, kept JSON for
  // schema parity across both engines). Read with
  // parseJson<string[]>(p.hashtags) on the consumer side.
  hashtags           String?
  // Per-product error from the last AI prompt-gen attempt. Cleared on
  // the next successful generation. Kept so the user sees *which*
  // product blew up without having to open every job.
  aiPromptError      String?
  aiPromptGeneratedAt DateTime?
  // Long-form product blurb shown on the posting-assist QR page.
  productDescription String?
  // Short (<=30 char) overlay label for the TikTok link sticker.
  // Null until the AI prompt is re-run with this field requested.
  productLinkDescription String?
  // Mobile-review workflow status. Defaults to "needs_review" for
  // every newly imported row so the user explicitly approves before
  // burning generations on it. Values:
  //   needs_review | approved | rejected | maybe
  // Image / video generation queries filter to reviewStatus="approved"
  // by default; GenerateImagesPanel exposes an override.
  reviewStatus       String   @default("needs_review")
  // TikTok Shop discount percentage the reviewer captured on the
  // mobile review card (they see the live TikTok Shop link and
  // type today's %). Feeds the APEX prompt generator's four
  // percentage-dependent hook variants (WAIT_3, DEAL_1, DEAL_5,
  // DEAL_6). Null when no discount is in effect / reviewer skipped
  // it — the generator falls back to the 30 non-% variants only.
  // Integer 1..100; anything outside that range is treated as null
  // at the action layer.
  discountPercent    Int?
  // Phase-5 mobile posting workflow status. Independent of
  // reviewStatus — defaults to "needs_posting" until the user
  // marks it posted via the mobile posting QR page.
  //   needs_posting | posted | skipped
  postingStatus      String   @default("needs_posting")
  // Free-form notes from the mobile posting page. Optional.
  postingNotes       String?
  // Soft delete. Non-null means hidden from default queries. Never
  // hard-delete a Product row so that linked Job/JobEvent rows and
  // the audit trail stay intact.
  deletedAt          DateTime?
  // Optional per-product override of the batch's market / preset.
  market             String?
  promptPreset       String?

  // Phase 9 — IP / trademark risk screening.
  //
  // This is a CONSERVATIVE screening tool, not legal advice. The
  // SaaS uses these fields to flag potentially counterfeit /
  // brand-impersonating / IP-infringing products BEFORE wasting
  // Flow credits on content for them. Two-layer detection:
  //   1. Deterministic heuristic (always runs, no API key)
  //   2. Optional AI-assisted second opinion (manual trigger only,
  //      to avoid surprise AI bills on every Kalodata import)
  // When both run, the higher risk score wins.
  //
  // Hard rule from the spec: messaging says "potential IP/trademark
  // risk detected; review manually before generating content." It
  // NEVER says "this product is illegal."
  //
  // Status transitions:
  //   unchecked → low | medium | high | needs_manual_review
  // High and needs_manual_review are excluded from image generation
  // by default; the user can override per-product with
  // ipRiskOverride=true + a written ipRiskOverrideReason.
  ipRiskStatus       String   @default("unchecked")
  // JSON-encoded array of human-readable reasons. Read with
  // parseJson<string[]>(p.ipRiskReasons) on the consumer side.
  // Nullable because "unchecked" products have nothing to say yet.
  ipRiskReasons      String?
  // When the last check ran. Null when status is "unchecked".
  ipRiskCheckedAt    DateTime?
  // User override: when true, eligible for generation even if
  // ipRiskStatus is "high" or "needs_manual_review".
  ipRiskOverride     Boolean  @default(false)
  // Free-form text — required when ipRiskOverride=true is set on
  // a high or needs_manual_review row.
  ipRiskOverrideReason String?
  // Timestamp the override was last set / changed.
  ipRiskOverrideAt   DateTime?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Phase 3 — up to 3 reference images per product. The first row
  // here (role="primary") is also reflected onto
  // referenceImageUrl / referenceImagePathLocal above as a
  // denormalised cache so existing read paths keep working without
  // a join.
  images             ProductImage[]
  // Phase 6 — Flow items bound to this product (generated images
  // / videos the user has approved for this product).
  flowItems          FlowItem[]

  @@index([batchId])
  @@index([reviewStatus])
  @@index([deletedAt])
  // Phase 9 — speeds up the batch-page filter dropdown + summary
  // counts (low/medium/high/needs_review per batch). Without the
  // index, each render scans the whole products table on a busy
  // workspace.
  @@index([ipRiskStatus])
}

// Phase 3 — additional reference images for a Product. Up to three
// (role primary / ref2 / ref3) to mirror the runner's existing
// REFERENCE_ROLES list. The runner already supports multiple
// references per product — this table is the SaaS-side equivalent.
//
// Why a separate table instead of a JSON column on Product:
//
//   - We need per-image metadata (source, dimensions, when added) and
//     a stable ID for the "Remove this image" UI to target.
//   - Listing distinct images by role is much cleaner with a row-per-
//     image schema; reordering happens via the role field, not array
//     indexing.
//   - Prisma handles the relation naturally; no JSON parsing glue on
//     the read side.
//
// The "primary" image is also denormalised onto
// Product.referenceImageUrl / .referenceImagePathLocal so all the
// existing thumbnail / dispatch / runner code paths keep working
// untouched. Writes to ProductImage(role="primary") MUST sync those
// fields back; the helper in lib/product-images.ts is the single
// chokepoint.
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // One of "primary" | "ref2" | "ref3". Matches the runner's
  // REFERENCE_ROLES tuple verbatim so a single string flows end-to-
  // end without translation.
  role      String
  // Public URL the SaaS serves the image at (e.g.
  // /uploads/workspaces/<ws>/batches/<b>/<productId>_ref2.jpg).
  // Optional only because a power user might supply a path-only
  // override; for the normal Kalodata/paste/upload path this is
  // always populated.
  url       String?
  // Optional local-filesystem path on the runner machine (debug
  // override). Same semantics as Product.referenceImagePathLocal —
  // when set, the runner prefers the path over the URL.
  pathLocal String?
  // Where the image came from: "kalodata" (auto-imported from the
  // Excel hero shot), "paste" (clipboard paste on the product card),
  // "upload" (drag/drop or file picker). Used for audit + future
  // analytics; doesn't affect runtime behaviour.
  source    String   @default("upload")
  // Optional dimensions captured at upload time. Lets the UI render
  // a sensible aspect-ratio placeholder before the image decodes.
  width     Int?
  height    Int?
  bytes     Int?
  createdAt DateTime @default(now())

  // One row per role per product — guarantees a product never has
  // two "primary" images and Phase 3 stays bounded at 3 refs.
  @@unique([productId, role])
  @@index([productId])
}

// Phase 6 — Flow reconciliation. See schema.prisma for the
// full module comment; this file mirrors the model exactly.
model FlowItem {
  id                String   @id @default(cuid())
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  batchId           String?
  batch             Batch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)
  productId         String?
  product           Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  mediaId           String?
  tileId            String?
  editId            String?
  tileHref          String?
  kind              String   @default("unknown")
  favorited         Boolean  @default(false)
  thumbnailUrl      String?
  bindState         String   @default("unbound")
  firstSeenJobId    String?
  firstSeenAt       DateTime @default(now())
  notes             String?
  updatedAt         DateTime @updatedAt

  @@unique([workspaceId, mediaId])
  @@index([workspaceId])
  @@index([batchId])
  @@index([productId])
  @@index([bindState])
}

// ---------------------------------------------------------------------------
// Jobs
// ---------------------------------------------------------------------------

// `status` is one of: "queued" | "running" | "succeeded" | "failed"
// | "cancelled". (SQLite doesn't support Prisma enums.)
//
// `payload` / `result` / `error` carry JSON encoded as a String. The
// server actions JSON.stringify on write; the page renderers
// JSON.parse on read. Moving to Postgres later: switch these to
// `Json` and drop the stringify/parse glue.
model Job {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  batchId     String?
  batch       Batch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)
  agentId     String?
  agent       Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
  jobType     String
  status      String   @default("queued")
  payload     String
  result      String?
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events JobEvent[]

  @@index([workspaceId])
  @@index([batchId])
  @@index([agentId])
  @@index([status])
}

model JobEvent {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  eventType String   // "progress" / "result" / "error"
  stage     String?
  message   String?
  current   Int?
  total     Int?
  details   String?
  createdAt DateTime @default(now())

  @@index([jobId])
}

// ---------------------------------------------------------------------------
// BOF Dashboard — multi-account TikTok Shop analytics.
//
// See the SQLite schema (prisma/schema.prisma) for the full architectural
// commentary. This overlay is structurally identical; only column types
// pick up the Postgres-specific @db.Decimal(12, 2) annotations.
// ---------------------------------------------------------------------------

model TikTokAccount {
  id              String   @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  label           String
  region          String   @default("US")
  cookieRaw       String
  monthlyToolCost Decimal  @default(0) @db.Decimal(12, 2)
  cookieStatus    String   @default("unchecked")
  cookieError     String?
  lastCheckedAt   DateTime?
  // See SQLite schema for full commentary — these are
  // per-refresh monthly totals from get_video_list_analytics.
  currentMonthGmv        Decimal   @default(0) @db.Decimal(12, 2)
  currentMonthDirectGmv  Decimal   @default(0) @db.Decimal(12, 2)
  currentMonthItemsSold  Int       @default(0)
  currentMonthCurrency   String    @default("USD")
  currentMonthAnchor     String    @default("")
  currentMonthCapturedAt DateTime?
  previousMonthGmv        Decimal   @default(0) @db.Decimal(12, 2)
  previousMonthDirectGmv  Decimal   @default(0) @db.Decimal(12, 2)
  previousMonthItemsSold  Int       @default(0)
  previousMonthCurrency   String    @default("USD")
  previousMonthAnchor     String    @default("")
  previousMonthCapturedAt DateTime?
  // CSV of ISO timestamps for the most recent SUCCESSFUL manual
  // refreshes (capped at 5 entries). Read by the manual-refresh
  // action to enforce a per-account cap of 3 refreshes per
  // rolling 12h. Cron refreshes don't write here — cron is gated
  // by its own schedule instead.
  manualRefreshLog String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  health   TikTokAccountHealth[]
  revenue  TikTokAccountRevenue[]
  products TikTokProduct[]
  productDaily TikTokProductDaily[]
  pnl      TikTokAccountPnl[]

  @@index([workspaceId])
}

model TikTokAccountHealth {
  id             String        @id @default(cuid())
  accountId      String
  account        TikTokAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  status         String
  violationScore Int
  restrictions   String?
  capturedAt     DateTime      @default(now())

  @@index([accountId, capturedAt])
}

model TikTokAccountRevenue {
  id                  String        @id @default(cuid())
  accountId           String
  account             TikTokAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date                DateTime      @db.Date
  // Sales — see SQLite schema for column-level commentary.
  gmv                 Decimal       @db.Decimal(12, 2)
  currencyCode        String        @default("USD")
  estimatedCommission Decimal       @db.Decimal(12, 2)
  videoRevenue        Decimal       @db.Decimal(12, 2)
  liveRevenue         Decimal       @db.Decimal(12, 2)
  itemsSold           Int
  // Content stats — vv_cnt / new_follower_cnt / video_cnt from
  // TikHub's get_video_analytics_summary endpoint.
  videoViews          Int           @default(0)
  newFollowerCount    Int           @default(0)
  videoCount          Int           @default(0)
  capturedAt          DateTime      @default(now())

  @@unique([accountId, date])
  @@index([accountId])
}

model TikTokProduct {
  id         String        @id @default(cuid())
  accountId  String
  account    TikTokAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  externalId String
  title      String
  gmv        Decimal       @db.Decimal(12, 2)
  currencyCode String      @default("USD")
  itemsSold  Int
  commission Decimal       @db.Decimal(12, 2)
  productViews  Int         @default(0)
  productClicks Int         @default(0)
  orderCount    Int         @default(0)
  capturedAt DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([accountId, externalId])
  @@index([accountId])
}

model TikTokProductDaily {
  id            String        @id @default(cuid())
  accountId     String
  account       TikTokAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  externalId    String
  date          DateTime      @db.Date
  gmv           Decimal       @default(0) @db.Decimal(12, 2)
  currencyCode  String        @default("USD")
  itemsSold     Int           @default(0)
  orderCount    Int           @default(0)
  productViews  Int           @default(0)
  productClicks Int           @default(0)
  capturedAt    DateTime      @default(now())

  @@unique([accountId, externalId, date])
  @@index([accountId, date])
  @@index([accountId, externalId])
}

// ---------------------------------------------------------------------------
// Product Research — TikTok Shop marketplace discovery + tracking.
//
// Distinct from `Product` (uploaded to /batches for content gen) and
// `TikTokProduct` (this creator's own sales from Creator API). See SQLite
// schema for full rationale.
// ---------------------------------------------------------------------------
model ShopProduct {
  id             String    @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  externalId     String
  title          String
  imageUrl       String?
  price          Decimal   @default(0) @db.Decimal(10, 2)
  commissionRate Decimal   @default(0) @db.Decimal(5, 2)
  category       String?
  isTracking     Boolean   @default(false)
  firstSeenAt    DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())

  snapshots ShopProductSnapshot[]

  @@unique([workspaceId, externalId])
  @@index([workspaceId, isTracking])
}

model ShopProductSnapshot {
  id           String      @id @default(cuid())
  productId    String
  product      ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  date         DateTime    @db.Date
  soldCount    Int         @default(0)
  creatorCount Int         @default(0)
  price        Decimal     @default(0) @db.Decimal(10, 2)
  capturedAt   DateTime    @default(now())

  @@unique([productId, date])
}

model TikTokAccountPnl {
  id              String        @id @default(cuid())
  accountId       String
  account         TikTokAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date            DateTime      @db.Date
  grossCommission Decimal       @db.Decimal(12, 2)
  toolCost        Decimal       @db.Decimal(12, 2)
  netProfit       Decimal       @db.Decimal(12, 2)
  capturedAt      DateTime      @default(now())

  @@unique([accountId, date])
  @@index([accountId])
}
