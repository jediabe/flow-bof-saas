// SaaS skeleton schema for Flow BOF Automation.
//
// Each model maps 1:1 to a concept from docs/ARCHITECTURE.md:
//   * User / Workspace               — accounts + tenancy.
//   * Agent                          — a registered local agent instance.
//   * Batch / Product                — the user's content.
//   * Job / JobEvent                 — work queued for an agent.
//
// The skeleton does NOT model billing, auth providers, or any
// browser-cookie / credential storage — that boundary is enforced in
// docs/SECURITY.md.

generator client {
  provider = "prisma-client-js"
}

// Skeleton dev uses SQLite — no service to run. To move to Postgres
// later, change `provider` to "postgresql" and point DATABASE_URL at
// a Postgres connection string. The `@db.Text` annotations in this
// file are removed for SQLite compatibility; restore them on
// `imagePrompt` (Product) and `message` (JobEvent) if you migrate.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  // bcrypt hash. Nullable so existing dev seed rows (created before
  // signup landed) still load; new rows always populate it via the
  // signup flow.
  passwordHash String?
  // One of: "admin" | "client". Single-user app today, but the
  // BOF Dashboard plumbing wants a role distinction baked in so a
  // future multi-tenant migration doesn't have to backfill.
  // Defaults to "admin" — existing rows stay full-access.
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspaces Workspace[] @relation("WorkspaceOwner")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agents     Agent[]
  batches    Batch[]
  jobs       Job[]
  settings   WorkspaceSettings?
  // Phase 6 — Flow reconciliation. One row per Flow media/tile the
  // SaaS has ever heard of, regardless of whether it originated
  // from a SaaS job. Scoped to the workspace so two tenants can't
  // collide on Flow's global media_id space.
  flowItems  FlowItem[]
  // BOF Dashboard — TikTok Shop accounts the operator has
  // connected. Scoped to workspace like everything else.
  tikTokAccounts TikTokAccount[]
  // Product Research — marketplace-discovered products the
  // operator is scouting/tracking. See ShopProduct at the
  // bottom of this file.
  shopProducts   ShopProduct[]
  // Workspace-scoped API token for programmatic access from
  // external scripts (currently: flow-bof-automation's
  // scripts/fetch_tiktok_cookies.py posts freshly-captured
  // cookies to /api/tiktok-accounts/add using this token as
  // Bearer auth). Null when no token has been minted; unique
  // constraint stops two workspaces from ever sharing one.
  // Rotate freely — old token is invalidated the moment a new
  // one is generated.
  apiToken   String? @unique
  // NOTE: Conversation used to live at workspace scope. Moved to
  // batch scope in the /prompts chat-panel refactor — see
  // Batch.conversations below.
}

// ---------------------------------------------------------------------------
// Batch-scoped LLM chat — conversations + messages
//
// Backs the chat panel inside /prompts. Each Batch has its own
// conversations so the operator's mental model ("I'm working on
// this batch") maps 1:1 to their transcript history. Cross-batch
// / workspace-level chat was the /generate page (deleted in the
// same commit that added this shape).
//
// One conversation can persist a "currentProductId" so switching
// back to it later remembers which product the operator was
// working on. Product selection drives which images the picker
// surfaces for attachment.

model Conversation {
  id          String   @id @default(cuid())
  batchId     String
  batch       Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  // Human-readable title — auto-derived from the first user
  // message or defaults to "New chat" until edited.
  title       String   @default("New chat")
  // Product currently focused in the chat panel — drives which
  // images show up in the reference picker. Null on a fresh
  // conversation; set when the operator picks a product.
  currentProductId String?
  // Soft-delete flag so a hidden thread doesn't lose its history.
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages    Message[]

  @@index([batchId, updatedAt(sort: Desc)])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // Role in the Anthropic Messages API sense:
  //   "user"      — operator input (also: tool_result items are
  //                 wrapped in a user message per the API contract,
  //                 stored under toolResultJson below)
  //   "assistant" — LLM output (also carries tool_use blocks
  //                 in toolCallsJson)
  role           String
  // Plain text content for user turns and text portions of
  // assistant turns.
  content        String   @default("")
  // JSON-encoded array of Anthropic tool_use blocks when
  // role="assistant" and the turn included tool calls.
  toolCallsJson  String?
  // JSON-encoded tool_result block when role="user" and this row
  // is the paired result for the previous assistant's tool_use.
  toolResultJson String?
  // JSON-encoded array of image URLs the operator attached to
  // this user turn (from the reference-image picker). Kept
  // separate from content so the raw text stays clean in the
  // transcript view; the agent runner rebuilds the prepended
  // "[Reference images: ...]" block when constructing the
  // Anthropic MessageParam on send.
  attachedImagesJson String?
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------------------
// Workspace-level settings — AI provider config, etc.
//
// ALPHA: API keys are stored *unencrypted* in this row. Acceptable for a
// localhost SQLite prototype; production must encrypt at rest (column-
// level KMS) or move them to a secrets manager. See docs/AI_PROVIDERS.md.
//
// Keys are never returned to client components in full; the settings
// server action returns a masked preview ("****abcd") plus a `set`
// boolean per key. Server-side workers read the row directly.
// ---------------------------------------------------------------------------

model WorkspaceSettings {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // One of: "manual" | "openai" | "anthropic" | "openrouter".
  aiProvider String @default("manual")

  openaiApiKey String?
  openaiModel  String?

  anthropicApiKey String?
  anthropicModel  String?

  openrouterApiKey  String?
  openrouterModel   String?
  openrouterSiteUrl String?
  openrouterAppName String?

  // Phase 9 IP / trademark risk screening. When false (default
  // after end-user feedback that the heuristic was too aggressive),
  // the deterministic + AI risk checks no longer GATE any product
  // from advancing to Ready or being dispatched for image
  // generation. Existing ipRiskStatus values on Product rows stay
  // for reference; they just stop blocking the workflow.
  ipRiskChecksEnabled Boolean @default(false)

  // Per-workspace overrides for the AI image-prompt system
  // prompts. When NULL, the bundled constant in
  // src/lib/ai/{uk,us}-retail-prompts.ts is used. When set, the
  // override text is fed to the AI provider verbatim. Lets the
  // user iterate on prompt wording without redeploying.
  ukSystemPromptOverride String?
  usSystemPromptOverride String?

  // v0.6.15-alpha anti-block hardening.
  // -----------------------------------------------------------
  // Daily cap on Flow image-gen submissions per workspace (24h
  // rolling window). reCAPTCHA Enterprise's
  // PUBLIC_ERROR_UNUSUAL_ACTIVITY_TOO_MUCH_TRAFFIC variant is a
  // volume signal — staying under this cap is the cheapest fix.
  // Default 50 picked from flow2api community reports of safe
  // volumes; user can raise or lower from Settings.
  dailyImageSubmitCap Int @default(50)

  // Timestamp of the most recent PUBLIC_ERROR_UNUSUAL_ACTIVITY*
  // hit reported by the runner. While this is within the
  // cooldown window the SaaS refuses to dispatch new image-gen
  // jobs and the batch page shows a cooldown banner.
  lastUnusualActivityAt   DateTime?
  lastUnusualActivityReason String?

  // How long after lastUnusualActivityAt before new jobs can
  // dispatch. 4 hours is a reasonable middle ground — long
  // enough for the session score to decay, short enough that
  // legitimate workloads aren't stuck overnight.
  cooldownHours Int @default(4)

  // Cap on how many ShopProduct rows in this workspace can carry
  // isTracking=true concurrently. Guards the per-workspace TikHub
  // bill against runaway Track clicks — every tracked product
  // costs ~2 API calls/day (snapshot + creator refresh × 4). 25
  // caps daily burn around ~$3-5/workspace at TikHub rates. The
  // Track action rejects clicks that would exceed this and points
  // the operator here.
  shopResearchMaxTracked Int @default(25)

  // Style 1 (Store Discovery) — ElevenLabs voice references.
  // The operator does a one-time voice-design step in ElevenLabs
  // (per the Loom Library PDF) and pastes the resulting voice ID
  // + a friendly label here. The mobile-posting page reads these
  // and reminds the operator which voice to paste the Part 1 +
  // Part 2 script into. NO ELEVENLABS API INTEGRATION — this is
  // pure UX plumbing; the operator still generates audio via the
  // ElevenLabs web UI.
  //   *Id     — the voice_id from ElevenLabs (opaque string,
  //             ~20 chars). Persisted as-is.
  //   *Label  — the operator's own friendly name for the voice
  //             (e.g. "Alicia"). Shown alongside the ID in the
  //             mobile posting reminder.
  // Separate UK + US pairs because the SOP mandates a market-
  // matched accent — one voice for the UK shop, one for US.
  elevenLabsVoiceIdUk    String?
  elevenLabsVoiceLabelUk String?
  elevenLabsVoiceIdUs    String?
  elevenLabsVoiceLabelUs String?

  // Style 1 — CapCut template share URL. The operator builds the
  // template once (all styling: music, hook text style, sale text
  // style, caption preset, timing) then pastes the shareable link
  // here. Mobile posting checklist renders it as a big "Open
  // CapCut template" button per product so assembly drops from
  // "start from scratch" to "fill 3 slots + type 2 text lines".
  // Null when unset — mobile posting shows a Settings nudge.
  capCutTemplateUrl String?

  // Google Flow account connected to this workspace via the APEX
  // MCP server. Populated after a successful cookie-blob upload
  // to /admin/accounts on the MCP. Used as the `flow_email` claim
  // on every JWT the app mints for /mcp tool calls, so the MCP
  // knows which of the (up to 50) Google Flow accounts on the
  // shared useapi.net subscription to act as.
  //
  // Null = no account connected yet. The /generate page and any
  // Flow-driven feature refuses to run until this is set.
  flowEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Agents — one row per registered local agent install.
// ---------------------------------------------------------------------------

// `status` is one of: "offline" | "online" | "unknown".
// (SQLite doesn't support Prisma enums — stored as a String. The
// TypeScript layer in src/lib/agent-client.ts + the page renderers
// know the valid set.)
model Agent {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  status      String    @default("unknown")
  baseUrl     String
  lastSeenAt  DateTime?

  // Connected-runner / polling-mode fields. The runner authenticates
  // by POSTing `Authorization: Bearer <runner_token>` to /api/runner/*;
  // only the SHA-256 hex digest of that token is stored here, so a
  // dump of the row never leaks usable credentials. `runnerTokenLast4`
  // is the human-readable preview the dashboard shows once the
  // one-time-display window has closed.
  runnerTokenHash  String?   @unique
  runnerTokenLast4 String?
  // Set the first time we see a successful /api/runner/health call
  // after generation. Cleared when the user revokes + regenerates.
  connectedAt      DateTime?
  // Bumped on every authenticated runner request — health, next-job,
  // event, complete, fail. Used to detect "runner is online right now".
  lastPollAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs Job[]

  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Content
// ---------------------------------------------------------------------------

model Batch {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  status       String    @default("draft")
  // Which TikTok Shop market this batch targets. Drives the prompt
  // template (UK retail vs US retail), hook/caption/hashtag style,
  // and posting-assist copy. Existing rows backfill to "uk" — the
  // workflow we shipped first.
  market       String    @default("uk")
  // Optional preset name. Leaves room for per-batch tweaks like
  // "uk-fashion-boutique" without inventing a new model.
  promptPreset String?
  // Long random URL-safe token for the phone product-review page
  // (Phase 4 mobile QR). Anyone-with-URL auth — token is generated
  // lazily the first time the user requests the QR, rotates on
  // demand. Null until then.
  reviewToken  String?   @unique
  // Same idea for the phone posting-assist page (Phase 5).
  postingToken String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  products  Product[]
  jobs      Job[]
  // Phase 6 — Flow items scoped to this batch. Used by the
  // Flow-reconciliation tab to group unmatched / bound / ignored
  // tiles per batch instead of mixing tiles from other batches.
  flowItems FlowItem[]
  // Chat-panel refactor: each batch owns its own /generate
  // conversations. Deletes cascade so a removed batch takes its
  // transcript with it.
  conversations Conversation[]

  @@index([workspaceId])
}

model Product {
  id                      String    @id @default(cuid())
  batchId                 String
  batch                   Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  productName             String
  originalTitle           String?
  tiktokUrl               String?
  category                String?
  retailerName            String?
  imageUrl                String?
  // Cloud-hosted reference image URL. Reserved for future signed-URL
  // download support; the local runner can't fetch these yet.
  referenceImageUrl       String?
  // Local filesystem path the runner uses to read the reference image
  // (e.g. "inputs/reference_images/01_primary.jpg"). Must resolve on
  // the runner machine. Phase-3-cloud will replace this with signed
  // URL downloads on the runner side.
  referenceImagePathLocal String?
  imagePrompt             String?
  // AI-generated supporting copy. Optional — populated by
  // generateAiPrompts; manual / deterministic fallback leaves them null.
  hook                    String?
  // JSON-encoded array of all hook variants the AI generated.
  // Shape: [{label: "A1"|...|"lever-1"|..., text: "...", lever_name?: string}]
  // The `hook` field above is hookVariants[0].text — kept as a
  // denormalised cache so mobile-posting / cooldown-banner consumers
  // that read a single hook keep working untouched. Empty / null
  // for products generated before this column existed.
  hookVariants            String?
  caption                 String?
  // JSON-encoded string[] (SQLite has no array type). Read with
  // parseJson<string[]>(p.hashtags) on the consumer side.
  hashtags                String?
  // Per-product error from the last AI prompt-gen attempt. Cleared on
  // the next successful generation. Kept so the user sees *which*
  // product blew up without having to open every job.
  aiPromptError           String?
  aiPromptGeneratedAt     DateTime?
  // Long-form product blurb the posting-assist QR page (Phase 5)
  // shows next to hook/caption/hashtags. Optional; populated by the
  // AI prompt generator when available.
  productDescription      String?
  // Short overlay text that appears as the link-sticker label on
  // the posted TikTok video — TikTok truncates the visible link
  // label, so the AI prompt is asked to condense the product to
  // <=30 chars. The mobile-posting page surfaces it as its own
  // copy block. Null until the AI prompt has been re-run for this
  // product after the field was introduced.
  productLinkDescription  String?
  // Style 1 (Store Discovery) — full generator kit for one product.
  // JSON blob shape (see src/lib/ai/style1.ts for the TS type):
  //   {
  //     scene1: { imagePrompt, motionPrompt, retailerName },
  //     scene2: { imagePrompt, motionPrompt, setting },
  //     copy:   { part1Options: [5], part2Options: [5], part3Options: [5] },
  //     hashtags: [5], productShortName, discountPercent, market
  //   }
  // Stored as JSON string; parsed via parseJson<Style1Kit>. Replaces
  // the old 30+-hook UK output entirely — the hookVariants column
  // stays but stops being written by the new prompt.
  style1Kit               String?
  // The specific option the operator picked on the mobile-posting
  // page for each of the three copy parts. Set as the operator
  // walks through the checklist (tapping Copy on an option). null
  // when they haven't picked yet. Persisted so a returning session
  // remembers which line was used, and so we can later analyse
  // which options actually get chosen (feedback for tuning the
  // Style 1 prompt).
  chosenCopyPart1         String?
  chosenCopyPart2         String?
  chosenCopyPart3         String?
  // Mobile-review workflow status. Defaults to "needs_review" for
  // every newly imported row so the user explicitly approves before
  // burning generations on it. Transition values:
  //   needs_review → approved | rejected | maybe
  //   approved     → rejected | maybe       (still allowed to flip)
  // Image / video generation queries filter to reviewStatus="approved"
  // by default; the GenerateImagesPanel exposes an "include
  // not-approved" override.
  reviewStatus            String    @default("needs_review")
  // TikTok Shop discount percentage the reviewer captured on the
  // mobile review card. Feeds the APEX prompt generator's four
  // %-dependent variants (WAIT_3, DEAL_1, DEAL_5, DEAL_6). Null
  // when no discount is in effect. Integer 1..100.
  discountPercent         Int?
  // Whether the discount is a claimable voucher/coupon or an
  // actual sale price. Per the Style 1 SOP: "Only say 'sale' if
  // it's an actual sale price (not a coupon)" — bait-and-switch
  // rule. Values: "voucher" (default, UK) / "coupon" (US) /
  // "sale". Null = fall back to voucher/coupon per market. The
  // LLM copy generator picks the exact wording from this field.
  discountType            String?
  // TikHub enrichment cache — populated on Kalodata import from
  // fetch_product_detail_v3. Both fields are SOURCE data, not
  // generated artifacts. The /prompts modal surfaces them so the
  // operator can copy image URLs into Google Flow and reference
  // the description for sanity-check + LLM context.
  //
  // sourceImages: JSON-encoded array of publicly-accessible TikTok
  //   CDN image URLs (up to 8). Includes primary + gallery. Null
  //   or empty when TikHub returned no images.
  // sourceDescription: HTML-stripped product description text from
  //   the listing, capped at 2000 chars. Null when unavailable.
  sourceImages            String?
  sourceDescription       String?
  // Enrichment status — populated by tikhub-enrichment.ts every
  // time it attempts a call for this product.
  //   null           = never attempted OR last attempt fully
  //                     succeeded and had nothing to log
  //   <human string> = last attempt failed in some way. Surfaced
  //                     inline on the /prompts modal as a red
  //                     banner so operators can see what went
  //                     wrong without SSHing for docker logs.
  //     e.g. "not-found in region GB — product may be delisted"
  //          "TikHub API error: returned 400"
  //          "no TikTok Shop URL in this row"
  enrichmentError         String?
  // Timestamp of the last enrichment attempt (successful or not).
  // Lets the UI say "attempted 3 min ago" alongside the error.
  enrichmentAttemptedAt   DateTime?
  // Phase-5 mobile posting workflow status. Independent of
  // reviewStatus — a product can be "approved" for generation AND
  // separately "posted" after the user has uploaded its video to
  // TikTok. Defaults to "needs_posting" for every product until
  // the user marks it posted via the mobile QR page.
  //   needs_posting | posted | skipped
  postingStatus           String    @default("needs_posting")
  // Free-form notes captured from the mobile posting page —
  // optional shopper-style remarks ("posted at 2pm", "swapped a
  // hashtag", etc.). Nullable; never required.
  postingNotes            String?
  // Soft delete. Non-null means hidden from default queries. We
  // never hard-delete a Product row so that linked Job/JobEvent
  // rows + the audit trail stay intact.
  deletedAt               DateTime?
  // Optional per-product overrides of the batch's market/preset —
  // lets a user import a primarily-UK batch with one US-only test
  // product without splitting the batch. Falls back to the batch's
  // value when null.
  market                  String?
  promptPreset            String?

  // Phase 9 — IP / trademark risk screening.
  //
  // This is a CONSERVATIVE screening tool, not legal advice. The
  // SaaS uses these fields to flag potentially counterfeit /
  // brand-impersonating / IP-infringing products BEFORE wasting
  // Flow credits on content for them. Two-layer detection:
  //   1. Deterministic heuristic (always runs, no API key)
  //   2. Optional AI-assisted second opinion (manual trigger only,
  //      to avoid surprise AI bills on every Kalodata import)
  // When both run, the higher risk score wins.
  //
  // Hard rule from the spec: messaging says "potential IP/trademark
  // risk detected; review manually before generating content." It
  // NEVER says "this product is illegal."
  //
  // Status transitions:
  //   unchecked → low | medium | high | needs_manual_review
  // High and needs_manual_review are excluded from image generation
  // by default; the user can override per-product with
  // ipRiskOverride=true + a written ipRiskOverrideReason.
  ipRiskStatus            String    @default("unchecked")
  // JSON-encoded array of human-readable reasons, e.g.
  //   ["Contains famous brand term: Nike",
  //    "Contains imitation phrase: designer inspired"]
  // Read with parseJson<string[]>(p.ipRiskReasons) on the consumer
  // side. SQLite has no array type; same pattern as the hashtags
  // column. Nullable because "unchecked" products have nothing to
  // say yet.
  ipRiskReasons           String?
  // When the last check ran. Null when status is "unchecked".
  // Used so the UI can show "checked 2 hours ago" and so a stale
  // check can be re-run after the product was edited.
  ipRiskCheckedAt         DateTime?
  // User override: when true, the product is eligible for
  // generation even if ipRiskStatus is "high" or
  // "needs_manual_review". Defaults to false; the override form
  // requires a written reason captured below.
  ipRiskOverride          Boolean   @default(false)
  // Free-form text from the user explaining why they're allowing
  // a high-risk product through (e.g. "verified official seller
  // with brand authorization", "generic compatibility product,
  // not infringing"). Required when ipRiskOverride=true is set on
  // a "high" or "needs_manual_review" row.
  ipRiskOverrideReason    String?
  // Timestamp the override was last set / changed. Audit trail —
  // we keep this so a future review can tell when a decision was
  // made and by which session.
  ipRiskOverrideAt        DateTime?

  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Phase 3 — up to 3 reference images per product. The first row
  // here (role="primary") is also reflected onto
  // referenceImageUrl / referenceImagePathLocal above as a
  // denormalised cache so existing read paths keep working without
  // a join.
  images                  ProductImage[]
  // Phase 6 — Flow items bound to this product (typically the
  // generated images / video derivatives the user has approved
  // for this product). A product can have multiple bound items
  // (e.g. one image variant + one animated video) — the relation
  // is one-to-many.
  flowItems               FlowItem[]
  // Videos the /generate agent produced via APEX MCP for this
  // product. Each row is a stable Flow mediaGenerationId we can
  // re-mint fresh signed URLs against on demand (they expire in
  // 6h; the id doesn't). See FlowGeneratedVideo below.
  flowGeneratedVideos     FlowGeneratedVideo[]

  @@index([batchId])
  @@index([reviewStatus])
  @@index([deletedAt])
  // Phase 9 — speeds up the batch-page filter dropdown + summary
  // counts (low/medium/high/needs_review per batch). Without the
  // index, each render scans the whole products table on a busy
  // workspace.
  @@index([ipRiskStatus])
}

// ---------------------------------------------------------------------------
// FlowGeneratedVideo — one row per video the /generate agent
// produced for a product via the APEX MCP tool loop.
//
// We store the mediaGenerationId (TikHub's stable handle) rather
// than a download URL because signed URLs from useapi.net expire
// in ~6h. The id resolves via google_flow_get_asset to a fresh
// URL on demand — cheap, no persistence of the actual video bytes
// needed on our side.
//
// sceneLabel maps this row to its slot in the Style 1 structure
// so mobile posting knows which video is "Scene 1 · store" vs
// "Scene 2 · home". Free-form "other" values allowed for future
// styles / one-off generations.

model FlowGeneratedVideo {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Style-1 slot: "scene_1_store" | "scene_2_home" | "combined"
  //             (full stitched video) | "other" (adhoc / test).
  sceneLabel        String
  // Stable Flow mediaGenerationId. Use google_flow_get_asset to
  // mint a fresh signed URL when needed. Never treat this as a
  // download link.
  mediaGenerationId String
  // Prompt the agent used to generate this video. Useful for
  // debugging + regenerate-with-tweak flows.
  prompt            String?
  // Free-form notes from the agent OR operator (e.g. "first
  // attempt, may regenerate for better lighting"). Rendered as
  // hover text in the mobile posting page's videos section.
  notes             String?
  createdAt         DateTime @default(now())

  @@index([productId, createdAt(sort: Desc)])
}

// Phase 3 — additional reference images for a Product. Up to three
// (role primary / ref2 / ref3) to mirror the runner's existing
// REFERENCE_ROLES list. The runner already supports multiple
// references per product — this table is the SaaS-side equivalent.
//
// Why a separate table instead of a JSON column on Product:
//
//   - We need per-image metadata (source, dimensions, when added) and
//     a stable ID for the "Remove this image" UI to target.
//   - Listing distinct images by role is much cleaner with a row-per-
//     image schema; reordering happens via the role field, not array
//     indexing.
//   - SQLite + Prisma handle the relation naturally; no JSON parsing
//     glue on the read side.
//
// The "primary" image is also denormalised onto
// Product.referenceImageUrl / .referenceImagePathLocal so all the
// existing thumbnail / dispatch / runner code paths keep working
// untouched. Writes to ProductImage(role="primary") MUST sync those
// fields back; the helper in lib/product-images.ts is the single
// chokepoint.
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // One of "primary" | "ref2" | "ref3". Matches the runner's
  // REFERENCE_ROLES tuple verbatim so a single string flows end-to-
  // end without translation.
  role      String
  // Public URL the SaaS serves the image at (e.g.
  // /uploads/workspaces/<ws>/batches/<b>/<productId>_ref2.jpg).
  // Optional only because a power user might supply a path-only
  // override; for the normal Kalodata/paste/upload path this is
  // always populated.
  url       String?
  // Optional local-filesystem path on the runner machine (debug
  // override). Same semantics as Product.referenceImagePathLocal —
  // when set, the runner prefers the path over the URL.
  pathLocal String?
  // Where the image came from: "kalodata" (auto-imported from the
  // Excel hero shot), "paste" (clipboard paste on the product card),
  // "upload" (drag/drop or file picker). Used for audit + future
  // analytics; doesn't affect runtime behaviour.
  source    String   @default("upload")
  // Optional dimensions captured at upload time. Lets the UI render
  // a sensible aspect-ratio placeholder before the image decodes.
  width     Int?
  height    Int?
  bytes     Int?
  createdAt DateTime @default(now())

  // One row per role per product — guarantees a product never has
  // two "primary" images and Phase 3 stays bounded at 3 refs.
  @@unique([productId, role])
  @@index([productId])
}

// Phase 6 — Flow reconciliation.
//
// One row per Flow media/tile the SaaS has ever heard of. Created
// by the scan ingester whenever a scan_favorited_images job
// returns a tile we haven't seen before, or when the originating
// item path (generate_flow_images) confirms a tile we expected.
//
// The bindState column drives the reconciliation UI:
//
//   "unbound"  Default for newly-discovered tiles whose origin we
//              can't tell. Lives in the "Unmatched" tray on the
//              Flow items tab; user can bind / ignore / animate.
//   "bound"    User explicitly bound this tile to a Product row.
//              Survives across scans — re-running the scan doesn't
//              re-promote bound items back to unbound.
//   "ignored"  User said "not relevant to this batch". Doesn't
//              show up in the default Unmatched view. Can be
//              un-ignored.
//   "auto"     Tile came from a SaaS-driven generate_flow_images
//              job and was matched back to its originating Product
//              via media_id / tile_id at ingest time. Functionally
//              equivalent to "bound" but distinguishable in the UI
//              ("this was generated FROM SaaS" vs "this was
//              manually bound").
//
// Why workspace-scoped uniqueness on (workspaceId, mediaId):
//   Flow's media_id is globally unique within Google's space but
//   we want one tenant's actions on a tile to be isolated from
//   another tenant's. (Practically: a single workspace owns all
//   the runners that touch its Google account.)
model FlowItem {
  id                String   @id @default(cuid())
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Optional batch + product scope — null when the tile is
  // genuinely unmatched. Bound tiles always have both. Ignored
  // tiles have batchId set (we ignored them in the context of a
  // specific batch) but productId null.
  batchId           String?
  batch             Batch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)
  productId         String?
  product           Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  // Flow-side identifiers from the runner's tile scan. mediaId is
  // the most reliable handle (extracted from the image URL);
  // tileId is composer position; editId is the /edit/<id> portion
  // of the deep-link to Flow's editor.
  mediaId           String?
  tileId            String?
  editId            String?
  tileHref          String?
  // What the runner thinks this tile is — "image" | "video" |
  // "unknown". Mirrors TileInfo.kind on the runner side.
  kind              String   @default("unknown")
  // Whether the tile had the favorite heart toggled ON at last
  // scan. We update this on every scan; it can flip back and
  // forth as the user hearts/unhearts in Flow directly.
  favorited         Boolean  @default(false)
  // Flow's /fx/api/trpc/media.getMediaUrlRedirect?name=<id> URL
  // for the tile's image. The thumbnail is fetched directly from
  // Flow — the SaaS does NOT cache final generated media (per the
  // hard rule "no SaaS storage of final generated videos").
  thumbnailUrl      String?
  // Reconciliation state — one of "unbound" | "bound" |
  // "ignored" | "auto". See module comment above.
  bindState         String   @default("unbound")
  // When this tile first showed up. Useful for "Show me tiles
  // from the last 24h" / "what arrived after the latest gen job"
  // queries the Phase-6 UI may want.
  firstSeenJobId    String?
  firstSeenAt       DateTime @default(now())
  // Free-form notes from the user. Used by the "Ignore" flow to
  // capture WHY a tile was ignored (e.g. "not the right product
  // — was a Flow auto-suggestion").
  notes             String?
  updatedAt         DateTime @updatedAt

  // mediaId is the stable handle — once we know it, an upsert
  // collapses duplicate scans into one row.
  @@unique([workspaceId, mediaId])
  @@index([workspaceId])
  @@index([batchId])
  @@index([productId])
  @@index([bindState])
}

// ---------------------------------------------------------------------------
// Jobs
// ---------------------------------------------------------------------------

// `status` is one of: "queued" | "running" | "succeeded" | "failed"
// | "cancelled". (SQLite doesn't support Prisma enums.)
//
// `payload` / `result` / `error` carry JSON encoded as a String. The
// server actions JSON.stringify on write; the page renderers
// JSON.parse on read. Moving to Postgres later: switch these to
// `Json` and drop the stringify/parse glue.
model Job {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  batchId     String?
  batch       Batch?    @relation(fields: [batchId], references: [id], onDelete: SetNull)
  agentId     String?
  agent       Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  jobType     String
  status      String    @default("queued")
  payload     String
  result      String?
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  events JobEvent[]

  @@index([workspaceId])
  @@index([batchId])
  @@index([agentId])
  @@index([status])
}

model JobEvent {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  eventType String // "progress" / "result" / "error"
  stage     String?
  message   String?
  current   Int?
  total     Int?
  details   String?
  createdAt DateTime @default(now())

  @@index([jobId])
}

// ---------------------------------------------------------------------------
// BOF Dashboard — multi-account TikTok Shop analytics.
//
// Operator connects one or more TikTok Shop creator accounts by pasting
// the session cookie string. We hit the unofficial TikHub API
// (api.tikhub.io) on a schedule, capture health/revenue/products into
// these tables, and the /analytics pages render from the DB (no
// TikHub call during a page render — too slow / rate-limited).
//
// Tenancy: Account is scoped to Workspace, like every other user
// resource. Reuses getCurrentWorkspace().
//
// Cookie storage: TikTokAccount.cookieRaw is AES-GCM encrypted at
// rest via lib/tikhub-crypto.ts. The plaintext is the full
// "key1=val1; key2=val2; ..." cookie header value TikHub expects.
// The 6 keys we extract are documented in lib/tikhub-cookie-parser.ts.
//
// Money: Decimal in dev (SQLite stores as text without precision
// loss for our magnitudes); the Postgres schema overlay carries the
// @db.Decimal(12,2) annotation. Choosing Decimal over integer cents
// keeps the queries readable.
// ---------------------------------------------------------------------------

model TikTokAccount {
  id              String   @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  label           String
  // "US" or "UK". String so SQLite stays portable; enforced in the
  // server actions on save.
  region          String   @default("US")
  // AES-GCM ciphertext of the raw cookie header. See lib/tikhub-
  // crypto.ts. Never logged. Never sent to the client; the
  // server-side TikHub call decrypts in-process.
  cookieRaw       String
  // Operator-entered USD cost / month for any tools used to support
  // this account (e.g., a portion of the BOF subscription, a
  // research tool sub, a phone line). Used in P&L proration.
  monthlyToolCost Decimal  @default(0)
  // One of: "unchecked" | "active" | "expired" | "error".
  // Default "unchecked" until the operator hits Test Cookie.
  cookieStatus    String   @default("unchecked")
  // Most recent TikHub error message when cookieStatus = "error".
  // Truncated to ~500 chars by the server actions before write.
  cookieError     String?
  lastCheckedAt   DateTime?
  // Current-calendar-month totals summed from
  // get_video_list_analytics per-video rows. Updated by every
  // products refresh — much fresher than the daily insights
  // rows and used as the canonical source for the "this month"
  // metric cards + net profit calc.
  currentMonthGmv         Decimal   @default(0)
  currentMonthDirectGmv   Decimal   @default(0)
  currentMonthItemsSold   Int       @default(0)
  currentMonthCurrency    String    @default("USD")
  currentMonthAnchor      String    @default("")
  currentMonthCapturedAt  DateTime?
  // Same snapshot for the PREVIOUS calendar month. Used for the
  // 30-day dashboard window, which spans two months from mid-month
  // "today". Populated by the same refresh call — one additional
  // paginated video-list walk per account per refresh.
  previousMonthGmv        Decimal   @default(0)
  previousMonthDirectGmv  Decimal   @default(0)
  previousMonthItemsSold  Int       @default(0)
  previousMonthCurrency   String    @default("USD")
  previousMonthAnchor     String    @default("")
  previousMonthCapturedAt DateTime?
  // CSV of ISO timestamps for the most recent SUCCESSFUL manual
  // refreshes (capped at 5 entries). Read by the manual-refresh
  // action to enforce a per-account cap of 3 refreshes per
  // rolling 12h. Cron refreshes don't write here — cron is gated
  // by its own schedule instead.
  manualRefreshLog String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  health   TikTokAccountHealth[]
  revenue  TikTokAccountRevenue[]
  products TikTokProduct[]
  productDaily TikTokProductDaily[]
  pnl      TikTokAccountPnl[]

  @@index([workspaceId])
}

model TikTokAccountHealth {
  id             String        @id @default(cuid())
  accountId      String
  account        TikTokAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // One of: "healthy" | "flagged" | "restricted" | "unknown".
  status         String
  // 0-100, TikHub's normalized violation score (higher = worse).
  violationScore Int
  // JSON-encoded string[] — restriction labels TikHub returned.
  // Parsed via parseJson<string[]> on read.
  restrictions   String?
  capturedAt     DateTime      @default(now())

  @@index([accountId, capturedAt])
}

model TikTokAccountRevenue {
  id                  String        @id @default(cuid())
  accountId           String
  account             TikTokAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // Bucket date in UTC. One row per (accountId, date).
  date                DateTime
  // ----- Sales -------------------------------------------------
  gmv                 Decimal
  // ISO 4217 currency the TikTok Shop account reports in. UK
  // accounts return GBP, US return USD, etc. Defaults to USD for
  // backfilled rows that pre-date the column.
  currencyCode        String        @default("USD")
  estimatedCommission Decimal
  videoRevenue        Decimal
  liveRevenue         Decimal
  itemsSold           Int
  // ----- Content -----------------------------------------------
  // Video views (`vv_cnt` in TikHub's get_video_analytics_summary),
  // new followers gained (`new_follower_cnt`), and videos posted
  // (`video_cnt`) during this bucket. These are the meaningful
  // metrics for affiliate creator accounts that haven't started
  // selling yet — pre-sale accounts still post videos and grow
  // audience, so we surface those numbers on the dashboard.
  videoViews          Int           @default(0)
  newFollowerCount    Int           @default(0)
  videoCount          Int           @default(0)
  capturedAt          DateTime      @default(now())

  @@unique([accountId, date])
  @@index([accountId])
}

model TikTokProduct {
  id         String        @id @default(cuid())
  accountId  String
  account    TikTokAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // TikHub's product id. Unique per account so re-poll updates the
  // row in place rather than duplicating.
  externalId String
  title      String
  gmv        Decimal
  // ISO 4217 code from TikHub's product_revenue.currency_code.
  currencyCode String        @default("USD")
  itemsSold  Int
  commission Decimal
  // Attribution funnel from get_video_to_product_stats — how many
  // product-card views / clicks / orders drove the sales above.
  // Populated by the video↔product chain in refresh.
  productViews  Int @default(0)
  productClicks Int @default(0)
  orderCount    Int @default(0)
  capturedAt DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([accountId, externalId])
  @@index([accountId])
}

// Per-day per-product attribution buckets, sourced from the
// finest-granularity (daily) segment of get_video_to_product_stats.
// The parent TikTokProduct row holds product METADATA (title,
// currency, latest-cycle snapshot). This table holds the raw
// per-day numbers so the "Top products by units sold" panel can
// window-filter accurately at query time instead of showing the
// whole month.
//
// Only non-zero buckets are stored (refresh skips days where the
// pair returned zeros). A missing row for a day means "no sales
// that day", which is fine for sum queries.
model TikTokProductDaily {
  id            String        @id @default(cuid())
  accountId     String
  account       TikTokAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // TikHub product id — matches TikTokProduct.externalId. Not a
  // FK constraint because product metadata upsert races with the
  // daily upserts; matching by (accountId, externalId) at query
  // time is safer than a hard foreign key.
  externalId    String
  date          DateTime      // UTC midnight of the bucket day
  gmv           Decimal       @default(0)
  currencyCode  String        @default("USD")
  itemsSold     Int           @default(0)
  orderCount    Int           @default(0)
  productViews  Int           @default(0)
  productClicks Int           @default(0)
  capturedAt    DateTime      @default(now())

  @@unique([accountId, externalId, date])
  @@index([accountId, date])
  @@index([accountId, externalId])
}

// ---------------------------------------------------------------------------
// Product Research — TikTok Shop marketplace discovery + tracking.
//
// Distinct from `Product` (uploaded to /batches for content gen) and
// `TikTokProduct` (this creator's own sales from Creator API). ShopProduct
// is *marketplace research data* — a product the operator is scouting or
// tracking as a candidate for future campaigns.
//
// Join key across all three: externalId is TikTok's `product_id`.
//
// Populated by the /research surface — Hot Products scan + Track button.
// Snapshots capture daily sold_count / creator_count / price to feed the
// 7d/14d growth calculations that drive BOF Score.
// ---------------------------------------------------------------------------
model ShopProduct {
  id             String   @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // TikTok's product_id. Same value that appears on TikTokProduct.externalId
  // for products this creator has actually promoted — the join key for the
  // "Posted Products" tab.
  externalId     String
  title          String
  // Local /uploads/shop-products/<workspaceId>/<externalId>.jpg after CDN
  // download. Never the raw TikTok CDN URL — those expire.
  imageUrl       String?
  price          Decimal  @default(0)
  commissionRate Decimal  @default(0)
  category       String?
  // Boolean toggle from the Hot Products card. When true the product is
  // included in the daily snapshot + creator-count refresh cron jobs.
  // Workspace-scoped cap enforced at the action layer against
  // WorkspaceSettings.shopResearchMaxTracked.
  isTracking     Boolean  @default(false)
  firstSeenAt    DateTime @default(now())
  // Last time the discovery scan re-encountered this product. Rows that
  // haven't been seen in weeks can be pruned as stale.
  lastSeenAt     DateTime @default(now())

  snapshots ShopProductSnapshot[]

  @@unique([workspaceId, externalId])
  @@index([workspaceId, isTracking])
}

model ShopProductSnapshot {
  id           String   @id @default(cuid())
  productId    String
  product      ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Calendar date the snapshot represents (UTC midnight). One snapshot per
  // product per day. Late-arriving refresh calls upsert into the same row
  // so we don't accumulate duplicates within a day.
  date         DateTime
  soldCount    Int      @default(0)
  // Count of creator videos promoting this product per the general_search
  // endpoint — the "creator saturation" signal that feeds BOF Score. Sweet
  // spot per curriculum: 20-200.
  creatorCount Int      @default(0)
  // Price captured at snapshot time. Sometimes changes daily on flash sales.
  price        Decimal  @default(0)
  capturedAt   DateTime @default(now())

  @@unique([productId, date])
}

model TikTokAccountPnl {
  id              String        @id @default(cuid())
  accountId       String
  account         TikTokAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date            DateTime
  grossCommission Decimal
  toolCost        Decimal
  netProfit       Decimal
  capturedAt      DateTime      @default(now())

  @@unique([accountId, date])
  @@index([accountId])
}
