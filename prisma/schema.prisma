// SaaS skeleton schema for Flow BOF Automation.
//
// Each model maps 1:1 to a concept from docs/ARCHITECTURE.md:
//   * User / Workspace               — accounts + tenancy.
//   * Agent                          — a registered local agent instance.
//   * Batch / Product                — the user's content.
//   * Job / JobEvent                 — work queued for an agent.
//
// The skeleton does NOT model billing, auth providers, or any
// browser-cookie / credential storage — that boundary is enforced in
// docs/SECURITY.md.

generator client {
  provider = "prisma-client-js"
}

// Skeleton dev uses SQLite — no service to run. To move to Postgres
// later, change `provider` to "postgresql" and point DATABASE_URL at
// a Postgres connection string. The `@db.Text` annotations in this
// file are removed for SQLite compatibility; restore them on
// `imagePrompt` (Product) and `message` (JobEvent) if you migrate.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  // bcrypt hash. Nullable so existing dev seed rows (created before
  // signup landed) still load; new rows always populate it via the
  // signup flow.
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspaces Workspace[] @relation("WorkspaceOwner")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agents     Agent[]
  batches    Batch[]
  jobs       Job[]
  settings   WorkspaceSettings?
  // Phase 6 — Flow reconciliation. One row per Flow media/tile the
  // SaaS has ever heard of, regardless of whether it originated
  // from a SaaS job. Scoped to the workspace so two tenants can't
  // collide on Flow's global media_id space.
  flowItems  FlowItem[]
}

// ---------------------------------------------------------------------------
// Workspace-level settings — AI provider config, etc.
//
// ALPHA: API keys are stored *unencrypted* in this row. Acceptable for a
// localhost SQLite prototype; production must encrypt at rest (column-
// level KMS) or move them to a secrets manager. See docs/AI_PROVIDERS.md.
//
// Keys are never returned to client components in full; the settings
// server action returns a masked preview ("****abcd") plus a `set`
// boolean per key. Server-side workers read the row directly.
// ---------------------------------------------------------------------------

model WorkspaceSettings {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // One of: "manual" | "openai" | "anthropic" | "openrouter".
  aiProvider String @default("manual")

  openaiApiKey String?
  openaiModel  String?

  anthropicApiKey String?
  anthropicModel  String?

  openrouterApiKey  String?
  openrouterModel   String?
  openrouterSiteUrl String?
  openrouterAppName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Agents — one row per registered local agent install.
// ---------------------------------------------------------------------------

// `status` is one of: "offline" | "online" | "unknown".
// (SQLite doesn't support Prisma enums — stored as a String. The
// TypeScript layer in src/lib/agent-client.ts + the page renderers
// know the valid set.)
model Agent {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  status      String    @default("unknown")
  baseUrl     String
  lastSeenAt  DateTime?

  // Connected-runner / polling-mode fields. The runner authenticates
  // by POSTing `Authorization: Bearer <runner_token>` to /api/runner/*;
  // only the SHA-256 hex digest of that token is stored here, so a
  // dump of the row never leaks usable credentials. `runnerTokenLast4`
  // is the human-readable preview the dashboard shows once the
  // one-time-display window has closed.
  runnerTokenHash  String?   @unique
  runnerTokenLast4 String?
  // Set the first time we see a successful /api/runner/health call
  // after generation. Cleared when the user revokes + regenerates.
  connectedAt      DateTime?
  // Bumped on every authenticated runner request — health, next-job,
  // event, complete, fail. Used to detect "runner is online right now".
  lastPollAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs Job[]

  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Content
// ---------------------------------------------------------------------------

model Batch {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  status       String    @default("draft")
  // Which TikTok Shop market this batch targets. Drives the prompt
  // template (UK retail vs US retail), hook/caption/hashtag style,
  // and posting-assist copy. Existing rows backfill to "uk" — the
  // workflow we shipped first.
  market       String    @default("uk")
  // Optional preset name. Leaves room for per-batch tweaks like
  // "uk-fashion-boutique" without inventing a new model.
  promptPreset String?
  // Long random URL-safe token for the phone product-review page
  // (Phase 4 mobile QR). Anyone-with-URL auth — token is generated
  // lazily the first time the user requests the QR, rotates on
  // demand. Null until then.
  reviewToken  String?   @unique
  // Same idea for the phone posting-assist page (Phase 5).
  postingToken String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  products  Product[]
  jobs      Job[]
  // Phase 6 — Flow items scoped to this batch. Used by the
  // Flow-reconciliation tab to group unmatched / bound / ignored
  // tiles per batch instead of mixing tiles from other batches.
  flowItems FlowItem[]

  @@index([workspaceId])
}

model Product {
  id                      String    @id @default(cuid())
  batchId                 String
  batch                   Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  productName             String
  originalTitle           String?
  tiktokUrl               String?
  category                String?
  retailerName            String?
  imageUrl                String?
  // Cloud-hosted reference image URL. Reserved for future signed-URL
  // download support; the local runner can't fetch these yet.
  referenceImageUrl       String?
  // Local filesystem path the runner uses to read the reference image
  // (e.g. "inputs/reference_images/01_primary.jpg"). Must resolve on
  // the runner machine. Phase-3-cloud will replace this with signed
  // URL downloads on the runner side.
  referenceImagePathLocal String?
  imagePrompt             String?
  // AI-generated supporting copy. Optional — populated by
  // generateAiPrompts; manual / deterministic fallback leaves them null.
  hook                    String?
  caption                 String?
  // JSON-encoded string[] (SQLite has no array type). Read with
  // parseJson<string[]>(p.hashtags) on the consumer side.
  hashtags                String?
  // Per-product error from the last AI prompt-gen attempt. Cleared on
  // the next successful generation. Kept so the user sees *which*
  // product blew up without having to open every job.
  aiPromptError           String?
  aiPromptGeneratedAt     DateTime?
  // Long-form product blurb the posting-assist QR page (Phase 5)
  // shows next to hook/caption/hashtags. Optional; populated by the
  // AI prompt generator when available.
  productDescription      String?
  // Mobile-review workflow status. Defaults to "needs_review" for
  // every newly imported row so the user explicitly approves before
  // burning generations on it. Transition values:
  //   needs_review → approved | rejected | maybe
  //   approved     → rejected | maybe       (still allowed to flip)
  // Image / video generation queries filter to reviewStatus="approved"
  // by default; the GenerateImagesPanel exposes an "include
  // not-approved" override.
  reviewStatus            String    @default("needs_review")
  // Phase-5 mobile posting workflow status. Independent of
  // reviewStatus — a product can be "approved" for generation AND
  // separately "posted" after the user has uploaded its video to
  // TikTok. Defaults to "needs_posting" for every product until
  // the user marks it posted via the mobile QR page.
  //   needs_posting | posted | skipped
  postingStatus           String    @default("needs_posting")
  // Free-form notes captured from the mobile posting page —
  // optional shopper-style remarks ("posted at 2pm", "swapped a
  // hashtag", etc.). Nullable; never required.
  postingNotes            String?
  // Soft delete. Non-null means hidden from default queries. We
  // never hard-delete a Product row so that linked Job/JobEvent
  // rows + the audit trail stay intact.
  deletedAt               DateTime?
  // Optional per-product overrides of the batch's market/preset —
  // lets a user import a primarily-UK batch with one US-only test
  // product without splitting the batch. Falls back to the batch's
  // value when null.
  market                  String?
  promptPreset            String?

  // Phase 9 — IP / trademark risk screening.
  //
  // This is a CONSERVATIVE screening tool, not legal advice. The
  // SaaS uses these fields to flag potentially counterfeit /
  // brand-impersonating / IP-infringing products BEFORE wasting
  // Flow credits on content for them. Two-layer detection:
  //   1. Deterministic heuristic (always runs, no API key)
  //   2. Optional AI-assisted second opinion (manual trigger only,
  //      to avoid surprise AI bills on every Kalodata import)
  // When both run, the higher risk score wins.
  //
  // Hard rule from the spec: messaging says "potential IP/trademark
  // risk detected; review manually before generating content." It
  // NEVER says "this product is illegal."
  //
  // Status transitions:
  //   unchecked → low | medium | high | needs_manual_review
  // High and needs_manual_review are excluded from image generation
  // by default; the user can override per-product with
  // ipRiskOverride=true + a written ipRiskOverrideReason.
  ipRiskStatus            String    @default("unchecked")
  // JSON-encoded array of human-readable reasons, e.g.
  //   ["Contains famous brand term: Nike",
  //    "Contains imitation phrase: designer inspired"]
  // Read with parseJson<string[]>(p.ipRiskReasons) on the consumer
  // side. SQLite has no array type; same pattern as the hashtags
  // column. Nullable because "unchecked" products have nothing to
  // say yet.
  ipRiskReasons           String?
  // When the last check ran. Null when status is "unchecked".
  // Used so the UI can show "checked 2 hours ago" and so a stale
  // check can be re-run after the product was edited.
  ipRiskCheckedAt         DateTime?
  // User override: when true, the product is eligible for
  // generation even if ipRiskStatus is "high" or
  // "needs_manual_review". Defaults to false; the override form
  // requires a written reason captured below.
  ipRiskOverride          Boolean   @default(false)
  // Free-form text from the user explaining why they're allowing
  // a high-risk product through (e.g. "verified official seller
  // with brand authorization", "generic compatibility product,
  // not infringing"). Required when ipRiskOverride=true is set on
  // a "high" or "needs_manual_review" row.
  ipRiskOverrideReason    String?
  // Timestamp the override was last set / changed. Audit trail —
  // we keep this so a future review can tell when a decision was
  // made and by which session.
  ipRiskOverrideAt        DateTime?

  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Phase 3 — up to 3 reference images per product. The first row
  // here (role="primary") is also reflected onto
  // referenceImageUrl / referenceImagePathLocal above as a
  // denormalised cache so existing read paths keep working without
  // a join.
  images                  ProductImage[]
  // Phase 6 — Flow items bound to this product (typically the
  // generated images / video derivatives the user has approved
  // for this product). A product can have multiple bound items
  // (e.g. one image variant + one animated video) — the relation
  // is one-to-many.
  flowItems               FlowItem[]

  @@index([batchId])
  @@index([reviewStatus])
  @@index([deletedAt])
  // Phase 9 — speeds up the batch-page filter dropdown + summary
  // counts (low/medium/high/needs_review per batch). Without the
  // index, each render scans the whole products table on a busy
  // workspace.
  @@index([ipRiskStatus])
}

// Phase 3 — additional reference images for a Product. Up to three
// (role primary / ref2 / ref3) to mirror the runner's existing
// REFERENCE_ROLES list. The runner already supports multiple
// references per product — this table is the SaaS-side equivalent.
//
// Why a separate table instead of a JSON column on Product:
//
//   - We need per-image metadata (source, dimensions, when added) and
//     a stable ID for the "Remove this image" UI to target.
//   - Listing distinct images by role is much cleaner with a row-per-
//     image schema; reordering happens via the role field, not array
//     indexing.
//   - SQLite + Prisma handle the relation naturally; no JSON parsing
//     glue on the read side.
//
// The "primary" image is also denormalised onto
// Product.referenceImageUrl / .referenceImagePathLocal so all the
// existing thumbnail / dispatch / runner code paths keep working
// untouched. Writes to ProductImage(role="primary") MUST sync those
// fields back; the helper in lib/product-images.ts is the single
// chokepoint.
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // One of "primary" | "ref2" | "ref3". Matches the runner's
  // REFERENCE_ROLES tuple verbatim so a single string flows end-to-
  // end without translation.
  role      String
  // Public URL the SaaS serves the image at (e.g.
  // /uploads/workspaces/<ws>/batches/<b>/<productId>_ref2.jpg).
  // Optional only because a power user might supply a path-only
  // override; for the normal Kalodata/paste/upload path this is
  // always populated.
  url       String?
  // Optional local-filesystem path on the runner machine (debug
  // override). Same semantics as Product.referenceImagePathLocal —
  // when set, the runner prefers the path over the URL.
  pathLocal String?
  // Where the image came from: "kalodata" (auto-imported from the
  // Excel hero shot), "paste" (clipboard paste on the product card),
  // "upload" (drag/drop or file picker). Used for audit + future
  // analytics; doesn't affect runtime behaviour.
  source    String   @default("upload")
  // Optional dimensions captured at upload time. Lets the UI render
  // a sensible aspect-ratio placeholder before the image decodes.
  width     Int?
  height    Int?
  bytes     Int?
  createdAt DateTime @default(now())

  // One row per role per product — guarantees a product never has
  // two "primary" images and Phase 3 stays bounded at 3 refs.
  @@unique([productId, role])
  @@index([productId])
}

// Phase 6 — Flow reconciliation.
//
// One row per Flow media/tile the SaaS has ever heard of. Created
// by the scan ingester whenever a scan_favorited_images job
// returns a tile we haven't seen before, or when the originating
// item path (generate_flow_images) confirms a tile we expected.
//
// The bindState column drives the reconciliation UI:
//
//   "unbound"  Default for newly-discovered tiles whose origin we
//              can't tell. Lives in the "Unmatched" tray on the
//              Flow items tab; user can bind / ignore / animate.
//   "bound"    User explicitly bound this tile to a Product row.
//              Survives across scans — re-running the scan doesn't
//              re-promote bound items back to unbound.
//   "ignored"  User said "not relevant to this batch". Doesn't
//              show up in the default Unmatched view. Can be
//              un-ignored.
//   "auto"     Tile came from a SaaS-driven generate_flow_images
//              job and was matched back to its originating Product
//              via media_id / tile_id at ingest time. Functionally
//              equivalent to "bound" but distinguishable in the UI
//              ("this was generated FROM SaaS" vs "this was
//              manually bound").
//
// Why workspace-scoped uniqueness on (workspaceId, mediaId):
//   Flow's media_id is globally unique within Google's space but
//   we want one tenant's actions on a tile to be isolated from
//   another tenant's. (Practically: a single workspace owns all
//   the runners that touch its Google account.)
model FlowItem {
  id                String   @id @default(cuid())
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Optional batch + product scope — null when the tile is
  // genuinely unmatched. Bound tiles always have both. Ignored
  // tiles have batchId set (we ignored them in the context of a
  // specific batch) but productId null.
  batchId           String?
  batch             Batch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)
  productId         String?
  product           Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  // Flow-side identifiers from the runner's tile scan. mediaId is
  // the most reliable handle (extracted from the image URL);
  // tileId is composer position; editId is the /edit/<id> portion
  // of the deep-link to Flow's editor.
  mediaId           String?
  tileId            String?
  editId            String?
  tileHref          String?
  // What the runner thinks this tile is — "image" | "video" |
  // "unknown". Mirrors TileInfo.kind on the runner side.
  kind              String   @default("unknown")
  // Whether the tile had the favorite heart toggled ON at last
  // scan. We update this on every scan; it can flip back and
  // forth as the user hearts/unhearts in Flow directly.
  favorited         Boolean  @default(false)
  // Flow's /fx/api/trpc/media.getMediaUrlRedirect?name=<id> URL
  // for the tile's image. The thumbnail is fetched directly from
  // Flow — the SaaS does NOT cache final generated media (per the
  // hard rule "no SaaS storage of final generated videos").
  thumbnailUrl      String?
  // Reconciliation state — one of "unbound" | "bound" |
  // "ignored" | "auto". See module comment above.
  bindState         String   @default("unbound")
  // When this tile first showed up. Useful for "Show me tiles
  // from the last 24h" / "what arrived after the latest gen job"
  // queries the Phase-6 UI may want.
  firstSeenJobId    String?
  firstSeenAt       DateTime @default(now())
  // Free-form notes from the user. Used by the "Ignore" flow to
  // capture WHY a tile was ignored (e.g. "not the right product
  // — was a Flow auto-suggestion").
  notes             String?
  updatedAt         DateTime @updatedAt

  // mediaId is the stable handle — once we know it, an upsert
  // collapses duplicate scans into one row.
  @@unique([workspaceId, mediaId])
  @@index([workspaceId])
  @@index([batchId])
  @@index([productId])
  @@index([bindState])
}

// ---------------------------------------------------------------------------
// Jobs
// ---------------------------------------------------------------------------

// `status` is one of: "queued" | "running" | "succeeded" | "failed"
// | "cancelled". (SQLite doesn't support Prisma enums.)
//
// `payload` / `result` / `error` carry JSON encoded as a String. The
// server actions JSON.stringify on write; the page renderers
// JSON.parse on read. Moving to Postgres later: switch these to
// `Json` and drop the stringify/parse glue.
model Job {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  batchId     String?
  batch       Batch?    @relation(fields: [batchId], references: [id], onDelete: SetNull)
  agentId     String?
  agent       Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  jobType     String
  status      String    @default("queued")
  payload     String
  result      String?
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  events JobEvent[]

  @@index([workspaceId])
  @@index([batchId])
  @@index([agentId])
  @@index([status])
}

model JobEvent {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  eventType String // "progress" / "result" / "error"
  stage     String?
  message   String?
  current   Int?
  total     Int?
  details   String?
  createdAt DateTime @default(now())

  @@index([jobId])
}
