# Copy this to .env.production and fill in real values before running
# `docker compose -f docker-compose.prod.yml up -d --build`.
#
# Everything in this file is read by Docker Compose. Anything inside
# `${...}` in docker-compose.prod.yml comes from here at compose-time;
# `env_file` lines pass the same values into the app container's
# process env at run-time.
#
# DO NOT COMMIT the filled-in version of this file. .gitignore already
# excludes .env / .env.* — keep it that way.

# ------------------------------------------------------------------
# Domain + URLs
# ------------------------------------------------------------------

# Hostname Caddy serves on. Used for Let's Encrypt automatic certs.
# Set to a real domain (DNS A record → VPS IP) for HTTPS, or `:80`
# to skip TLS while you test the box.
APP_DOMAIN=app.example.com

# Public-facing URL the app embeds in absolute links (e.g. reference
# image URLs the local runner downloads). Same scheme + host as
# APP_DOMAIN. No trailing slash.
NEXT_PUBLIC_APP_URL=https://app.example.com

# URL the local runner uses to fetch reference images that the SaaS
# stored under /uploads/. Usually identical to NEXT_PUBLIC_APP_URL.
# Override only if the runner is on a different network and reaches
# the SaaS by a different hostname (e.g. a tunnel).
AGENT_ASSET_BASE_URL=https://app.example.com

NODE_ENV=production

# ------------------------------------------------------------------
# Runner mode — direct vs polling
# ------------------------------------------------------------------
# - polling : SaaS queues Jobs at status="queued"; the local runner
#             reaches us via /api/runner/* with a Bearer token. This
#             is the only mode that works for a hosted SaaS, because
#             the SaaS can't punch into the user's localhost.
# - direct  : SaaS calls the agent's `baseUrl` directly. Used for
#             local dev where the SaaS and runner share a host.
APP_RUNNER_MODE=polling

# ------------------------------------------------------------------
# Postgres
# ------------------------------------------------------------------
# `db` is the docker-compose service name. The Prisma client + the
# Next.js app connect to it by that name on the default compose network.
DATABASE_URL=postgresql://flowbof:CHANGE_ME_STRONG_PASSWORD@db:5432/flow_bof_saas

POSTGRES_DB=flow_bof_saas
POSTGRES_USER=flowbof
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ------------------------------------------------------------------
# Storage
# ------------------------------------------------------------------
# Where Kalodata-downloaded reference images live INSIDE the
# container. The compose file bind-mounts ./uploads from the host to
# this path. Don't change unless you also change the volume mount.
UPLOAD_DIR=/app/public/uploads

# ------------------------------------------------------------------
# Optional HTTP Basic Auth outer gate (off by default)
# ------------------------------------------------------------------
# The app now ships with real user signup + login; the public site
# at https://app.autobof.xyz uses that as its only auth layer.
# Leave both of these blank for a normal production deploy.
#
# When BOTH variables are set to non-empty values, middleware
# enforces HTTP Basic Auth on every page + API route except
# /api/health, /api/runner/*, and Next's static asset paths. Use
# this ONLY for short-lived private staging / preview environments
# where you want a quick credential gate in front of the whole
# site. Never use it instead of real auth for prod — it doesn't
# enforce per-user permissions, the credentials get cached by the
# browser, and basic-auth headers travel in plaintext below TLS.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Signs the app's session cookies (HS256 JWT). MUST be at least 32
# characters; the app refuses to start auth flows otherwise. Generate
# with: openssl rand -base64 48
AUTH_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# ------------------------------------------------------------------
# Runner download links — OPTIONAL but recommended
# ------------------------------------------------------------------
# Direct links to the platform-specific FlowBOFRunner builds you've
# uploaded to GitHub Releases. Used by the SaaS Runner Setup page to
# render real "Download" buttons.
#
# Recommended pattern: GitHub's /releases/latest/download/<file> URL.
# It's a stable redirect that always points at the latest published
# release's asset, so you set this ONCE and never have to update
# the env when you cut new releases — just publish a release that
# has assets named the same way.
#
# Example values (uncomment + adjust):
#   NEXT_PUBLIC_RUNNER_WINDOWS_RELEASE_URL=https://github.com/jediabe/flow-bof-automation/releases/latest/download/FlowBOFRunner.exe
#   NEXT_PUBLIC_RUNNER_MAC_RELEASE_URL=https://github.com/jediabe/flow-bof-automation/releases/latest/download/FlowBOFRunner-mac-alpha.dmg
#   NEXT_PUBLIC_RUNNER_RELEASES_URL=https://github.com/jediabe/flow-bof-automation/releases
#
# When both *_RELEASE_URLs are unset, the Windows card falls back to
# RELEASES_URL (or its hardcoded default) and the Mac card renders a
# disabled "set the env var" button. So the worst case is still a
# valid landing page.
#
# These MUST be NEXT_PUBLIC_* so they're embedded into the client
# bundle at build time.
NEXT_PUBLIC_RUNNER_WINDOWS_RELEASE_URL=
NEXT_PUBLIC_RUNNER_MAC_RELEASE_URL=
NEXT_PUBLIC_RUNNER_RELEASES_URL=

# ------------------------------------------------------------------
# AI providers — OPTIONAL
# ------------------------------------------------------------------
# Real AI keys are stored in the WorkspaceSettings row via the
# Settings UI. These env vars are just convenient seeds for an admin
# bootstrap script — the running app doesn't read them. Leave blank
# unless you've added that bootstrap path.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ------------------------------------------------------------------
# BOF Dashboard — TikHub + cookie encryption + cron
# ------------------------------------------------------------------
# All three of these MUST be set before the /analytics or
# /settings/tiktok-accounts pages can do anything. Missing any one
# of them and the affected code path 500s.

# TikHub API key — https://tikhub.io. One key covers all
# workspaces; per-account TikTok Shop cookies are a separate
# secret stored per TikTokAccount row in Postgres. Never commit.
TIKHUB_API_KEY=

# AES-GCM key for encrypting TikTok session cookies at rest.
# Must be 32 bytes base64-encoded (44 chars). Generate with:
#   openssl rand -base64 32
# Once real cookies are stored under this key, rotating it makes
# every existing cookie undecryptable — operators have to re-paste
# from TikTok. Treat as write-once for the life of the deployment.
TIKTOK_COOKIE_ENC_KEY=

# Bearer token the scheduled refresh cron passes to
# /api/cron/{task}. Any random string works; ~32 chars recommended.
# Generate with:
#   openssl rand -base64 32
# Whatever calls the cron URL (docker sidecar, GitHub Actions,
# external hitter) sends this in the Authorization: Bearer header.
CRON_SECRET=
