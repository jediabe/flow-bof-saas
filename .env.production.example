# Copy this to .env.production and fill in real values before running
# `docker compose -f docker-compose.prod.yml up -d --build`.
#
# Everything in this file is read by Docker Compose. Anything inside
# `${...}` in docker-compose.prod.yml comes from here at compose-time;
# `env_file` lines pass the same values into the app container's
# process env at run-time.
#
# DO NOT COMMIT the filled-in version of this file. .gitignore already
# excludes .env / .env.* — keep it that way.

# ------------------------------------------------------------------
# Domain + URLs
# ------------------------------------------------------------------

# Hostname Caddy serves on. Used for Let's Encrypt automatic certs.
# Set to a real domain (DNS A record → VPS IP) for HTTPS, or `:80`
# to skip TLS while you test the box.
APP_DOMAIN=app.example.com

# Public-facing URL the app embeds in absolute links (e.g. reference
# image URLs the local runner downloads). Same scheme + host as
# APP_DOMAIN. No trailing slash.
NEXT_PUBLIC_APP_URL=https://app.example.com

# URL the local runner uses to fetch reference images that the SaaS
# stored under /uploads/. Usually identical to NEXT_PUBLIC_APP_URL.
# Override only if the runner is on a different network and reaches
# the SaaS by a different hostname (e.g. a tunnel).
AGENT_ASSET_BASE_URL=https://app.example.com

NODE_ENV=production

# ------------------------------------------------------------------
# Postgres
# ------------------------------------------------------------------
# `db` is the docker-compose service name. The Prisma client + the
# Next.js app connect to it by that name on the default compose network.
DATABASE_URL=postgresql://flowbof:CHANGE_ME_STRONG_PASSWORD@db:5432/flow_bof_saas

POSTGRES_DB=flow_bof_saas
POSTGRES_USER=flowbof
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ------------------------------------------------------------------
# Storage
# ------------------------------------------------------------------
# Where Kalodata-downloaded reference images live INSIDE the
# container. The compose file bind-mounts ./uploads from the host to
# this path. Don't change unless you also change the volume mount.
UPLOAD_DIR=/app/public/uploads

# ------------------------------------------------------------------
# Private-alpha basic auth
# ------------------------------------------------------------------
# When BOTH are set, middleware enforces HTTP Basic Auth on every
# page + API route except /api/health and Next's static asset paths.
# Leave blank to disable (the app becomes publicly reachable —
# do that only behind a separate firewall / VPN).
BASIC_AUTH_USER=alpha
BASIC_AUTH_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# A long random secret for any session/cookie signing we add later.
# Generate with: openssl rand -base64 48
AUTH_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# ------------------------------------------------------------------
# AI providers — OPTIONAL
# ------------------------------------------------------------------
# Real AI keys are stored in the WorkspaceSettings row via the
# Settings UI. These env vars are just convenient seeds for an admin
# bootstrap script — the running app doesn't read them. Leave blank
# unless you've added that bootstrap path.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
